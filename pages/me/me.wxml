<!-- pages/me/me.wxml -->
<view class="page">
  <!-- 头部 -->
  <view class="header">
    <view class="avatar">
      <text class="avatar-text">🍖</text>
    </view>
    <text class="username">肉肉的主人</text>
    <text class="motto">好好吃饭，认真生活</text>
  </view>

  <!-- 统计数据 -->
  <view class="stats-section">
    <view class="stat-card">
      <text class="stat-number">{{stats.total}}</text>
      <text class="stat-label">我的菜谱</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{stats.categories}}</text>
      <text class="stat-label">分类</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{stats.recently}}</text>
      <text class="stat-label">本周新增</text>
    </view>
  </view>

  <!-- 分类管理 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🏷️ 菜谱分类</text>
      <view class="add-btn" bindtap="addCategory">+ 添加</view>
    </view>
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="index"
        class="category-tag"
      >
        <text>{{item}}</text>
        <view class="delete-icon" bindtap="deleteCategory" data-index="{{index}}">×</view>
      </view>
    </view>
  </view>

  <!-- 菜谱管理 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">📚 菜谱管理</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="exportData">
        <text class="menu-icon">📤</text>
        <text class="menu-text">导出数据</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item danger" bindtap="clearAllData">
        <text class="menu-icon">🗑️</text>
        <text class="menu-text">清空所有数据</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">💡 关于</text>
    </view>
    <view class="about-card">
      <text class="about-name">肉肉食谱</text>
      <text class="about-version">版本 1.0.0</text>
      <text class="about-desc">属于你的个人菜谱管家，记录每一道想吃的菜</text>
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="tab-bar">
    <view class="tab-item" bindtap="goToHome">
      <text class="tab-icon">🏠</text>
      <text>首页</text>
    </view>
    <view class="tab-item" bindtap="goToCalendar">
      <text class="tab-icon">📅</text>
      <text>计划</text>
    </view>
    <view class="tab-item active">
      <text class="tab-icon">👤</text>
      <text>我的</text>
    </view>
  </view>
</view>
