/* pages/me/me.wxss */

.page {
  min-height: 100vh;
  background: var(--bg-primary);
  padding-bottom: 160rpx;
}

/* 头部 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
  background: linear-gradient(180deg, #FFF5F3 0%, var(--bg-primary) 100%);
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, var(--primary) 0%, #FF8A7A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(232, 93, 76, 0.3);
}

.avatar-text {
  font-size: 80rpx;
}

.username {
  font-family: var(--font-handwriting);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.motto {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 统计数据 */
.stats-section {
  display: flex;
  padding: 0 40rpx;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  flex: 1;
  background: var(--bg-secondary);
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.stat-number {
  display: block;
  font-family: var(--font-handwriting);
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 区块 */
.section {
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-family: var(--font-handwriting);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.add-btn {
  padding: 10rpx 24rpx;
  background: var(--primary);
  color: white;
  border-radius: 30rpx;
  font-size: 24rpx;
  cursor: pointer;
  transition: transform 0.2s;
}

.add-btn:active {
  transform: scale(0.95);
}

/* 分类列表 */
.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: var(--bg-secondary);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.delete-icon {
  font-size: 32rpx;
  color: var(--text-muted);
  cursor: pointer;
  transition: color 0.2s;
}

.delete-icon:active {
  color: var(--danger);
}

/* 菜单列表 */
.menu-list {
  background: var(--bg-secondary);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
  cursor: pointer;
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #FFF8F7;
}

.menu-item.danger .menu-text {
  color: var(--danger);
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 40rpx;
  color: var(--text-muted);
}

/* 关于卡片 */
.about-card {
  background: var(--bg-secondary);
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.about-name {
  display: block;
  font-family: var(--font-handwriting);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.about-version {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 20rpx;
}

.about-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 底部导航 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background: var(--bg-secondary);
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 40rpx;
  cursor: pointer;
  transition: transform 0.2s;
}

.tab-item:active {
  transform: scale(0.9);
}

.tab-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}

.tab-item text:last-child {
  font-size: 22rpx;
  color: var(--text-muted);
}

.tab-item.active text:last-child {
  color: var(--primary);
  font-weight: 600;
}
