<!-- pages/detail/detail.wxml -->
<view class="page" wx:if="{{recipe}}">
  <!-- 头部 -->
  <view class="header-bar">
    <view class="back-btn" bindtap="navigateBack">
      <text>←</text>
    </view>
    <text class="header-title">菜谱详情</text>
    <view class="share-btn" bindtap="deleteRecipe">
      <text>🗑️</text>
    </view>
  </view>

  <!-- 主图区域 -->
  <view class="hero-section">
    <view class="hero-bg"></view>
    <view class="hero-content">
      <text class="dish-emoji">{{recipe.category === '甜点' ? '🍰' : recipe.category === '饮品' ? '🥤' : recipe.category === '快手菜' ? '⚡' : '🍲'}}</text>
      <text class="dish-name">{{recipe.name}}</text>
      <view class="dish-tags">
        <text class="tag tag-white">{{recipe.category}}</text>
        <text class="tag tag-white">{{recipe.ingredients.length}}种配料</text>
      </view>
    </view>
  </view>

  <!-- 配料区 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🥬 配料清单</text>
      <view class="copy-btn" bindtap="copyIngredients">
        <text>{{copied ? '已复制 ✓' : '复制全部'}}</text>
      </view>
    </view>
    <view class="ingredient-list">
      <view
        wx:for="{{recipe.ingredients}}"
        wx:key="index"
        class="ingredient-item"
      >
        <view class="ingredient-dot"></view>
        <text class="ingredient-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 做法区 -->
  <view class="section" wx:if="{{recipe.steps && recipe.steps.length > 0}}">
    <view class="section-header">
      <text class="section-title">👨‍🍳 烹饪步骤</text>
      <view class="copy-btn" bindtap="copySteps">
        <text>复制步骤</text>
      </view>
    </view>
    <view class="step-list">
      <view
        wx:for="{{recipe.steps}}"
        wx:key="index"
        class="step-item"
      >
        <view class="step-number">{{index + 1}}</view>
        <text class="step-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <button class="btn-cook" open-type="share">
      <text>📤</text>
      <text>分享给好友</text>
    </button>
  </view>
</view>

<!-- 空状态 -->
<view class="empty-page" wx:if="{{!recipe}}">
  <text class="empty-emoji">❓</text>
  <text class="empty-text">菜谱不存在</text>
  <button class="btn btn-primary" bindtap="navigateBack">返回首页</button>
</view>
